<%- include('partials-head', { pageTitle }) %>
<section class="page-title-row">
  <div>
    <a class="back-link" href="/themes/<%= theme.key %>">← Back to <%= theme.shortTitle %></a>
    <div class="theme-title"><div class="theme-icon large">⚑</div><div><span class="eyebrow">Theme issue tracker</span><h1>Issues</h1><p class="muted"><%= theme.title %></p></div></div>
  </div>
</section>

<section class="panel issue-compose">
  <div class="panel-head"><div><h2>Report an issue</h2><p class="muted">Describe the issue and attach supporting images if needed.</p></div></div>
  <form action="/themes/<%= theme.key %>/issues" method="post" enctype="multipart/form-data" class="stack-form">
    <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
    <label>Issue details<textarea name="description" rows="5" maxlength="10000" required placeholder="Type the issue, what happened, and any relevant details..."></textarea></label>
    <div class="upload-box issue-upload"><div class="upload-symbol">🖼️</div><h3>Attach images</h3><p>Choose up to 20 images. Maximum <strong>10 MB per image</strong>.</p><input type="file" name="images" accept="image/jpeg,image/png,image/webp,image/gif,image/bmp,image/avif,image/heic,image/heif,image/tiff" multiple data-max-size="10485760"><small class="muted" id="issueFileHint">No images selected</small></div>
    <div class="form-actions"><a class="btn btn-outline" href="/themes/<%= theme.key %>">Cancel</a><button class="btn btn-primary" type="submit">Save Issue</button></div>
  </form>
</section>

<section class="section-heading theme-section-heading"><div><span class="eyebrow eyebrow-muted">Saved records</span><h2>Reported issues</h2><p class="section-description">Issues are stored separately for this theme.</p></div><span class="section-count"><strong><%= issues.length %></strong><span>ISSUES</span></span></section>
<section class="issue-list">
  <% if (!issues.length) { %><div class="empty-state"><div class="empty-icon">✓</div><h2>No issues reported</h2><p>When an issue is submitted, it will appear here with its attached images.</p></div><% } %>
  <% issues.forEach(issue => { %>
    <article class="panel issue-card">
      <div class="issue-meta"><strong>Issue #<%= issue.id %></strong><span><%= issue.createdBy %></span><span><%= new Date(issue.createdAt).toLocaleString() %></span></div>
      <p class="issue-description"><%= issue.description %></p>
      <% if (issue.images.length) { %><div class="issue-images"><% issue.images.forEach(img => { %><a href="/issue-images/<%= img.id %>" target="_blank" rel="noopener"><img src="/issue-images/<%= img.id %>" alt="<%= img.originalName %>" loading="lazy"></a><% }) %></div><% } %>
      <% if (issue.images.length) { %><p class="muted issue-image-count"><%= issue.images.length %> attached image<%= issue.images.length === 1 ? '' : 's' %></p><% } %>
    </article>
  <% }) %>
</section>
<%- include('partials-foot') %>
